# Copies of other people's pages and pictures: readable again at any time, and not ours to publish.
sources-local/
growth/**/*.png
network/**/*.png
names/**/*.png
# Caches, locks and logs the tools rebuild by themselves.
ytcheck-cache.json
ytscout-subs.json
.ytcheck.lock*
*.err
# Designers' proof sheets: rebuilt by preview.mjs at any time.
design/previews/
# Intermediate renders: rebuilt by production/edit.py.
production/**/build/
# Rendered episodes and test cuts: rebuilt from their edit lists by production/edit.py; too large for git.
production/**/*-test.mp4
production/**/render/
production/**/final.mp4
# The joined narration is rebuilt from the section files; over GitHub's size limit.
production/**/narration/full.wav
__pycache__/
